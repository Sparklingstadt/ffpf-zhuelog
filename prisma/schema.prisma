generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id         String          @id @default(cuid())
  fileName   String
  rowCount   Int
  importedAt DateTime        @default(now())
  entries    LearningEntry[]
}

model LearningEntry {
  id            String      @id @default(cuid())
  kind          String      @default("correction")
  originalText  String
  correctedText String
  pinyin        String
  createdAt     DateTime    @default(now())
  // Set while the note is in its owner's trash.
  deletedAt     DateTime?
  // Set while the owner shares the note with the members who follow them.
  sharedAt      DateTime?
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hints         Hint[]

  @@index([userId, createdAt])
  @@index([userId, deletedAt])
  @@index([userId, sharedAt])
  @@index([batchId])
}

model Hint {
  id              String        @id @default(cuid())
  content         String
  position        Int
  learningEntryId String
  learningEntry   LearningEntry @relation(fields: [learningEntryId], references: [id], onDelete: Cascade)

  @@unique([learningEntryId, position])
  @@index([learningEntryId])
}

// Table dropped in 20261127100000_owner_to_user; model removed with its code in Task 6/7.
// Password sign-in for members. Managed by GitHub admins at /admin/accounts.
model PasswordAccount {
  id             String    @id @default(cuid())
  loginId        String    @unique
  displayName    String
  passwordHash   String
  sessionVersion Int       @default(0)
  // Unused since sign-in throttling moved to SignInThrottle. Kept so the
  // previous deployment keeps working while the migration is rolled out;
  // drop them in a later migration.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Table dropped in 20261127100000_owner_to_user; model removed with its code in Task 6/7.
// A member who signs in with Sparklingstadt ID (issued by sparklingstadt-id). id is the
// Sparklingstadt ID server's sub; the ownerId is "sid:" + id. email is for display only and is
// never used for authorization.
model SidAccount {
  id             String   @id
  email          String
  displayName    String
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastLoginAt    DateTime
}

// Table dropped in 20261127100000_owner_to_user; model removed with its code in Task 6/7.
// Fixed-window sign-in attempt counters, written by the web's sign-in (the retired Go API wrote the same keys).
// Keys always include the client address ("client:<ip>",
// "login:<ip>:<loginId>"), so nobody can lock another person out from
// elsewhere; "password-change:<accountId>" is only reachable by the signed-in
// member. Rows past expiresAt are dead and pruned opportunistically.
model SignInThrottle {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// One-way follow between users. The use cases check that the followee is a
// member (not an admin or a guest).
model Follow {
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

// Table dropped in 20261127100000_owner_to_user; model removed with its code in Task 6/7.
// A signed-in browser of the own session scheme (stage 11 of the Go retirement). The cookie holds a
// random token; only its SHA-256 is kept here. role/login/sessionVersion are
// what Go's refresh tokens kept (the ApiRefreshToken table, dropped in stage
// 12b), so the per-request check stayed the same. The CHECK constraint in the
// migration pins the shape of each role.
model LegacySession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique // SHA-256 hex of the cookie's token
  ownerId        String
  role           String // "admin" | "member" | "guest"
  login          String? // admin only: GitHub login at sign-in (display only)
  sessionVersion Int? // member only: the account's sessionVersion at sign-in
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([ownerId])
  @@index([expiresAt])
  @@map("Session")
}

// Ties one LINE account to one Zhuelog user. The role is the user's
// ("user"."role").
// reviewNotify is the owner's choice to get a LINE message on mornings when
// reviews are due (off until they turn it on); reviewNotifiedOn is the JST
// date the last one was sent, so the daily run sends at most one a day.
model LineLink {
  lineUserId       String    @id
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  reviewNotify     Boolean   @default(false)
  reviewNotifiedOn DateTime? @db.Date
}

// One-time link codes shown on /account/line. Only the SHA-256 hex of the code
// is stored; issuing a new code replaces the previous one of the same owner.
model LineLinkCode {
  codeHash  String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

// A LINE message waiting for, or done with, correction/translation by the Go
// API. text is cleared once the row is done or failed. webhookEventId makes
// redelivered webhooks idempotent. kind is "correction" | "translation" and
// status is "pending" | "done" | "failed" (CHECK); the (status, createdAt)
// index is declared in the migration's SQL.
model LineMessage {
  id             String   @id @default(cuid())
  webhookEventId String   @unique
  lineUserId     String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  text           String?
  status         String   @default("pending")
  attempts       Int      @default(0)
  entryId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

// A member's or admin's practice conversation with ChatGPT, saved whole by the web
// after every answer. id is a UUID made by the browser; messages is
// [{id, role, text}] with role "user" | "assistant".
model ChatConversation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  modelName String
  ended     Boolean
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

// One finished round of preposition practice by a member or admin, written by
// the web (before stage 8, by the Go API). id is a UUID made by the
// browser, so a retried save keeps one row. questions is [{id?, answer, noun, prompt, misses}] in the order asked,
// with the wrong prepositions picked in misses; id is the question's id in the
// Web's practice data and older rounds have none. The counts are derived from
// it by Go.
model PrepositionPracticeRecord {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionCount Int
  firstTryCount Int
  missCount     Int
  elapsedMs     Int
  questions     Json
  startedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([id, userId])
  @@index([userId, createdAt])
}

// One question and one complete answer, independent of chat conversations.
model QuickQuestion {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  modelName String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Complement rounds, isolated from preposition history. mode: result/potential/degree/
// direction-simple/direction-compound/direction-simple-extended/direction-compound-extended/
// verb, measure for the measure-word practice and aspect for the 了・过・着 practice,
// whose rounds are kept here.
model ComplementPracticeRecord {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String
  questionCount Int
  firstTryCount Int
  missCount     Int
  elapsedMs     Int
  questions     Json
  startedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([id, userId])
  @@index([userId, createdAt])
}

// Something a member or admin reviews on a spaced-repetition schedule (FSRS),
// one row per owner and target. kind says what targetId names: "preposition"
// (a use id and its noun), "complement" (a question id), "vocabulary" (a
// word's id) or "entry" (a learning note the owner put in review; its item
// is left out while the note is in the trash and deleted with the note).
// language is the language studied ("zh"). The FSRS card state
// is kept as columns so the due items can be picked with an index.
// state: 0 new, 1 learning, 2 review, 3 relearning.
model ReviewItem {
  id             String      @id
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  language       String
  kind           String
  targetId       String
  due            DateTime
  stability      Float       @default(0)
  difficulty     Float       @default(0)
  scheduledDays  Int         @default(0)
  reps           Int         @default(0)
  lapses         Int         @default(0)
  state          Int         @default(0)
  remainingSteps Int         @default(0)
  lastReview     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  logs           ReviewLog[]

  @@unique([userId, language, kind, targetId])
  @@index([userId, due])
}

// One answer to a review: the rating (1 again, 2 hard, 3 good, 4 easy) and
// the card as it stood just before it, so the FSRS parameters can later be
// fitted to the owner's history. The id comes from the client, so a retried
// answer is applied once.
model ReviewLog {
  id            String     @id
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId        String
  item          ReviewItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rating        Int
  state         Int
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  reviewedAt    DateTime

  @@index([itemId, reviewedAt])
  @@index([userId, reviewedAt])
}

// A word or phrase an owner picked out to learn, with its reading and
// meaning (drafted by AI, edited by the owner). Each one is also a
// ReviewItem of kind "vocabulary" whose targetId is this id; deleting the
// entry deletes that item too (the web does both in one transaction).
// sourceEntryId is the learning note it was picked from, kept as a plain
// reference: the note may later go to the trash or be deleted.
model VocabularyEntry {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language      String
  word          String
  pinyin        String
  meaning       String
  sourceEntryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, language, word])
  @@index([userId, createdAt])
}

// One OpenAI call: who it was for, which feature, and the tokens it used.
// Written by the web (and by the retired Go API before stage 8); read by the admin's monthly summary.
model AiUsage {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Better Auth's tables (1.7.28), shaped as `@better-auth/cli generate` would for
// the username, anonymous and admin plugins and database rate limiting. The
// table names are lower case, so they sit beside the legacy "Session" table.
model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  username        String?   @unique
  displayUsername String?
  isAnonymous     Boolean?  @default(false)
  role            String?   @default("user")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  // Everything the user owns; deleting the user deletes it.
  learningEntries            LearningEntry[]
  chatConversations          ChatConversation[]
  prepositionPracticeRecords PrepositionPracticeRecord[]
  quickQuestions             QuickQuestion[]
  complementPracticeRecords  ComplementPracticeRecord[]
  reviewItems                ReviewItem[]
  reviewLogs                 ReviewLog[]
  vocabularyEntries          VocabularyEntry[]
  aiUsages                   AiUsage[]
  lineLink                   LineLink?
  lineLinkCode               LineLinkCode?
  lineMessages               LineMessage[]
  following                  Follow[]                    @relation("Follower")
  followers                  Follow[]                    @relation("Followee")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
