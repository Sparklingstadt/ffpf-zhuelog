generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id         String          @id @default(cuid())
  fileName   String
  rowCount   Int
  importedAt DateTime        @default(now())
  entries    LearningEntry[]
}

model LearningEntry {
  id            String      @id @default(cuid())
  kind          String      @default("correction")
  originalText  String
  correctedText String
  pinyin        String
  createdAt     DateTime    @default(now())
  // Set while the note is in its owner's trash.
  deletedAt     DateTime?
  // Set while the owner shares the note with the members who follow them.
  sharedAt      DateTime?
  ownerId       String
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hints         Hint[]

  @@index([ownerId, createdAt])
  @@index([ownerId, deletedAt])
  @@index([ownerId, sharedAt])
  @@index([batchId])
}

model Hint {
  id              String        @id @default(cuid())
  content         String
  position        Int
  learningEntryId String
  learningEntry   LearningEntry @relation(fields: [learningEntryId], references: [id], onDelete: Cascade)

  @@unique([learningEntryId, position])
  @@index([learningEntryId])
}

// Password sign-in for members. Managed by GitHub admins at /admin/accounts.
model PasswordAccount {
  id             String    @id @default(cuid())
  loginId        String    @unique
  displayName    String
  passwordHash   String
  sessionVersion Int       @default(0)
  // Unused since sign-in throttling moved to SignInThrottle. Kept so the
  // previous deployment keeps working while the migration is rolled out;
  // drop them in a later migration.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A member who signs in with FFPF ID (issued by ffpf-portal). id is the
// portal's sub; the ownerId is "ffpf:" + id. email is for display only and is
// never used for authorization.
model FfpfAccount {
  id             String   @id
  email          String
  displayName    String
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastLoginAt    DateTime
}

// Fixed-window sign-in attempt counters, shared by the web app and the Go API.
// Keys always include the client address ("client:<ip>",
// "login:<ip>:<loginId>"), so nobody can lock another person out from
// elsewhere; "password-change:<accountId>" is only reachable by the signed-in
// member. Rows past expiresAt are dead and pruned opportunistically.
model SignInThrottle {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// One-way follow. Admins have no row in the database, so neither column has a
// foreign key: the use cases check that the followee is an existing member.
model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

// Refresh tokens issued by the Go mobile API (services/api). Only the SHA-256
// hash of the token is stored. Tokens of one login share a familyId so reuse of
// a rotated token can revoke the whole family. ownerId has no foreign key:
// admins have no row in the database.
model ApiRefreshToken {
  id             String    @id @default(cuid())
  ownerId        String
  role           String // "admin" | "member"
  login          String? // admin only: GitHub login at issue time
  sessionVersion Int? // member only: PasswordAccount.sessionVersion at issue time
  tokenHash      String    @unique // SHA-256 hex
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([familyId])
  @@index([ownerId])
}

// Ties one LINE account to one Zhuelog owner (a PasswordAccount id prefixed
// "password:", or an admin's GitHub numeric id). ownerId has no foreign key:
// admins have no row in the database. role is "member" | "admin" (CHECK).
// reviewNotify is the owner's choice to get a LINE message on mornings when
// reviews are due (off until they turn it on); reviewNotifiedOn is the JST
// date the last one was sent, so the daily run sends at most one a day.
model LineLink {
  lineUserId       String    @id
  ownerId          String    @unique
  role             String
  createdAt        DateTime  @default(now())
  reviewNotify     Boolean   @default(false)
  reviewNotifiedOn DateTime? @db.Date
}

// One-time link codes shown on /account/line. Only the SHA-256 hex of the code
// is stored; issuing a new code replaces the previous one of the same owner.
// role is "member" | "admin" (CHECK).
model LineLinkCode {
  codeHash  String   @id
  ownerId   String   @unique
  role      String
  expiresAt DateTime
}

// A LINE message waiting for, or done with, correction/translation by the Go
// API. text is cleared once the row is done or failed. webhookEventId makes
// redelivered webhooks idempotent. kind is "correction" | "translation" and
// status is "pending" | "done" | "failed" (CHECK); the (status, createdAt)
// index is declared in the migration's SQL.
model LineMessage {
  id             String   @id @default(cuid())
  webhookEventId String   @unique
  lineUserId     String
  ownerId        String
  kind           String
  text           String?
  status         String   @default("pending")
  attempts       Int      @default(0)
  entryId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

// A member's or admin's practice conversation with ChatGPT, saved whole by the Go API
// after every answer. id is a UUID made by the browser; messages is
// [{id, role, text}] with role "user" | "assistant". ownerId has no foreign
// key: admins have no row in the database.
model ChatConversation {
  id        String   @id
  ownerId   String
  title     String
  modelName String
  ended     Boolean
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ownerId])
  @@index([ownerId, updatedAt])
  @@index([ownerId, createdAt])
}

// One finished round of preposition practice by a member or admin, written by
// the Go API. id is a UUID made by the browser, so a retried save keeps one
// row. questions is [{id?, answer, noun, prompt, misses}] in the order asked,
// with the wrong prepositions picked in misses; id is the question's id in the
// Web's practice data and older rounds have none. The counts are derived from
// it by Go. ownerId has no foreign key: admins have no row in the database.
model PrepositionPracticeRecord {
  id            String   @id
  ownerId       String
  questionCount Int
  firstTryCount Int
  missCount     Int
  elapsedMs     Int
  questions     Json
  startedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
}

// One question and one complete answer, independent of chat conversations.
model QuickQuestion {
  id        String   @id
  ownerId   String
  question  String
  answer    String
  modelName String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

// Complement rounds, isolated from preposition history. mode: result/potential/degree/
// direction-simple/direction-compound/direction-simple-extended/direction-compound-extended/
// verb, measure for the measure-word practice and aspect for the 了・过・着 practice,
// whose rounds are kept here.
model ComplementPracticeRecord {
  id            String   @id
  ownerId       String
  mode          String
  questionCount Int
  firstTryCount Int
  missCount     Int
  elapsedMs     Int
  questions     Json
  startedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
}

// Something a member or admin reviews on a spaced-repetition schedule (FSRS),
// one row per owner and target. kind says what targetId names: "preposition"
// (a use id and its noun), "complement" (a question id), "vocabulary" (a
// word's id) or "entry" (a learning note the owner put in review; its item
// is left out while the note is in the trash and deleted with the note).
// language is the language studied ("zh"). The FSRS card state
// is kept as columns so the Go API can pick the due items with an index.
// state: 0 new, 1 learning, 2 review, 3 relearning.
model ReviewItem {
  id             String      @id
  ownerId        String
  language       String
  kind           String
  targetId       String
  due            DateTime
  stability      Float       @default(0)
  difficulty     Float       @default(0)
  scheduledDays  Int         @default(0)
  reps           Int         @default(0)
  lapses         Int         @default(0)
  state          Int         @default(0)
  remainingSteps Int         @default(0)
  lastReview     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  logs           ReviewLog[]

  @@unique([ownerId, language, kind, targetId])
  @@index([ownerId, due])
}

// One answer to a review: the rating (1 again, 2 hard, 3 good, 4 easy) and
// the card as it stood just before it, so the FSRS parameters can later be
// fitted to the owner's history. The id comes from the client, so a retried
// answer is applied once.
model ReviewLog {
  id            String     @id
  ownerId       String
  itemId        String
  item          ReviewItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rating        Int
  state         Int
  due           DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  reviewedAt    DateTime

  @@index([itemId, reviewedAt])
  @@index([ownerId, reviewedAt])
}

// A word or phrase an owner picked out to learn, with its reading and
// meaning (drafted by AI, edited by the owner). Each one is also a
// ReviewItem of kind "vocabulary" whose targetId is this id; deleting the
// entry deletes that item too (the Go API does both in one transaction).
// sourceEntryId is the learning note it was picked from, kept as a plain
// reference: the note may later go to the trash or be deleted.
model VocabularyEntry {
  id            String   @id
  ownerId       String
  language      String
  word          String
  pinyin        String
  meaning       String
  sourceEntryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, language, word])
  @@index([ownerId, createdAt])
}

// One OpenAI call: who it was for, which feature, and the tokens it used.
// Written only by the Go API; read by the admin's monthly summary.
model AiUsage {
  id           String   @id
  ownerId      String
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([ownerId, createdAt])
}
