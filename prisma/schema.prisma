generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id         String          @id @default(cuid())
  fileName   String
  rowCount   Int
  importedAt DateTime        @default(now())
  entries    LearningEntry[]
}

model LearningEntry {
  id            String      @id @default(cuid())
  originalText  String
  correctedText String
  pinyin        String
  createdAt     DateTime    @default(now())
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hints         Hint[]
  @@index([createdAt])
  @@index([batchId])
}

model Hint {
  id              String        @id @default(cuid())
  content         String
  position        Int
  learningEntryId String
  learningEntry   LearningEntry @relation(fields: [learningEntryId], references: [id], onDelete: Cascade)
  @@unique([learningEntryId, position])
  @@index([learningEntryId])
}

// Durable inbox + outbox. Kept separate so existing notes work before enabling LINE.
model LineLearningJob {
  id              String   @id @default(cuid())
  kind            String   @default("correction")
  eventId         String   @unique
  userId          String
  originalText    String
  receivedAt      DateTime
  createdAt       DateTime @default(now())
  status          String   @default("PENDING")
  leaseToken      String?
  availableAt     DateTime @default(now())
  generationTries Int      @default(0)
  deliveryTries   Int      @default(0)
  csv             String?
  replyText       String?
  entryId         String?  @unique
  retryKey        String   @unique
  firstDeliveryAt DateTime?
  failureCode     String?
  issueAttempted  Boolean  @default(false)

  @@index([status, availableAt])
}

model LineDevelopmentSession {
  userId      String   @id
  expiresAt   DateTime?
  lastEventAt DateTime
}
