generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id         String          @id @default(cuid())
  fileName   String
  rowCount   Int
  importedAt DateTime        @default(now())
  entries    LearningEntry[]
}

model LearningEntry {
  id            String      @id @default(cuid())
  kind          String      @default("correction")
  originalText  String
  correctedText String
  pinyin        String
  createdAt     DateTime    @default(now())
  // Set while the note is in its owner's trash.
  deletedAt     DateTime?
  // Set while the owner shares the note with the members who follow them.
  sharedAt      DateTime?
  ownerId       String
  batchId       String
  batch         ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  hints         Hint[]
  @@index([ownerId, createdAt])
  @@index([ownerId, deletedAt])
  @@index([ownerId, sharedAt])
  @@index([batchId])
}

model Hint {
  id              String        @id @default(cuid())
  content         String
  position        Int
  learningEntryId String
  learningEntry   LearningEntry @relation(fields: [learningEntryId], references: [id], onDelete: Cascade)
  @@unique([learningEntryId, position])
  @@index([learningEntryId])
}

// Password sign-in for members. Managed by GitHub admins at /admin/accounts.
model PasswordAccount {
  id             String    @id @default(cuid())
  loginId        String    @unique
  displayName    String
  passwordHash   String
  sessionVersion Int       @default(0)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// One-way follow. Admins have no row in the database, so neither column has a
// foreign key: the use cases check that the followee is an existing member.
model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}
