# --- Web（Next.js）---
# Web がすべての機能を受け持ちます（docs/deployment.md の 2.）。
# AUTH_URL: Web の公開 origin。GitHub と FFPF ID の redirect_uri（<origin>/api/auth/callback/github/go と /api/auth/callback/ffpf）がここから決まり、登録した URL と 1 文字も違わないこと。
AUTH_URL="Web の公開 origin（例: http://localhost:3000）"
# GitHub でのログイン（管理者だけ）。AUTH_GITHUB_ID と GITHUB_WEB_CLIENT_SECRET の両方が無いと、GitHub のボタンは押せません。ローカルでは使えません（本物の OAuth App が要る）。
AUTH_GITHUB_ID="Web 用 GitHub OAuth App の Client ID"
GITHUB_WEB_CLIENT_SECRET=""
# FFPF ID でのログイン（任意。3 つそろうと「FFPF IDでログイン」を出します）。
# FFPF_ID_ISSUER="FFPF ID（portal）の issuer（例: https://ffpf-portal.vercel.app、末尾スラッシュなし）"
# FFPF_ID_CLIENT_ID="portal に登録した zhuelog のクライアント ID"
# FFPF_ID_CLIENT_SECRET="portal の pnpm run oidc:client で作ったシークレット"
# 「LINE 連携」画面に出す、LINE 公式アカウントの友だち追加リンク（https:// で始まるものだけ使います。空なら出しません）。
# LINE_ADD_FRIEND_URL="https://line.me/R/ti/p/@your-account"
# 連携コード入りの QR と「LINEで開く」ボタンの送信先（公開ID）。
# LINE_OFFICIAL_ACCOUNT_ID="@393bohaw"
# ローカル専用DBで表示確認する場合は true（本番ボットに送れないQRを非表示）。
# LINE_LINK_PREVIEW_MODE="true"

# --- Web が実行時に DB を使う（docs/deployment.md の 2.）---
# Web は、ログイン中の人を決めるために、Cookie zl_session のトークンから DB の Session の行を引き、アカウントを Prisma で読みます。
# DATABASE_URL: Prisma のマイグレーションと seed、Web の実行時の DB の読み書きに使います。本番の実行時は Neon の pooled の URL。
#   手元では下の値（docker compose up -d の開発用 DB）のまま使い、サンプルの会員は pnpm run db:seed:sample で入れます（docs/development.md）。
#   開発用 DB は 127.0.0.1:55432 です（ZHUELOG_DB_PORT で替えられます。替えたら下のポートも合わせる）。
#   「address already in use」や Prisma の P1010 が出たら、ほかの Postgres がそのポートを使っています。
# AUTH_ALLOWED_GITHUB_IDS: 管理者にする GitHub ユーザーの数字の ID（カンマ区切り。空なら管理者は誰も通らない）。Web がモジュールを読み込むときに 1 度だけ読むので、変えたら再デプロイする。
# DEMO_LOGIN_ID: デモアカウントのログイン ID（任意。Web がデモのログインとリセット /api/cron/demo-reset に使い、空ならデモのボタンは出ず、そのルートは 404）。
DATABASE_URL="postgresql://zhuelog:zhuelog@localhost:55432/zhuelog?schema=public"
# 単語帳は Web が DB と OpenAI を直接使います（docs/deployment.md の 2.）。
# OPENAI_API_KEY: 「AI で下書き」に使う OpenAI の API キー（無ければ下書きは「今は使えません」）。
# OPENAI_LEARNING_MODEL: 下書きと LINE の添削・翻訳のモデル（任意。無ければ gpt-5-mini）。
# OPENAI_CHAT_MODEL: クイック質問と ChatGPT と話すのモデル（任意。無ければ gpt-6.1-sol）。
# OPENAI_API_BASE_URL はテスト専用（ループバックの URL だけ。Production と Preview には設定しない）。
# OPENAI_API_KEY=""
# OPENAI_LEARNING_MODEL="gpt-5-mini"
# OPENAI_CHAT_MODEL="gpt-6.1-sol"
# LINE の webhook と拾い直しは Web が受けます（docs/deployment.md の 3.。移したときの手順は同じ文書の「移行の記録」）。
# LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN: LINE のチャネルシークレットと長期のアクセストークン（本番のチャネルの値）。
#   2 つと OPENAI_API_KEY がそろわないと、LINE 連携は使えません（/api/line/webhook は 404、画面は「LINE 連携は今は使えません。」）。
#   Vercel では Production だけに入れ、Preview には入れません（プレビューが本物の LINE に返事をしないように）。
# CRON_SECRET: /api/cron/line-drain と /api/cron/demo-reset の Authorization: Bearer の秘密（Production だけ。空なら常に 401）。
# LINE_API_BASE_URL はテスト専用（ループバックの URL だけ。Production と Preview には設定しない。e2e は e2e/line-stub.ts に向ける）。
# LINE_CHANNEL_SECRET=""
# LINE_CHANNEL_ACCESS_TOKEN=""
# CRON_SECRET=""
AUTH_ALLOWED_GITHUB_IDS="0"
DEMO_LOGIN_ID="demo"
