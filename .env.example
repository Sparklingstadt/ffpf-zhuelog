# --- Web（Next.js）---
# Web はログインも学習ノートの読み書きも Go API で行います（docs/api-deployment.md の 6.）。
# ローカルでは pnpm run api:dev の Go API（127.0.0.1:8081）を使います。
GO_API_URL="http://127.0.0.1:8081"
API_WEB_PROXY_SECRET="Go API と同じ値（32バイト以上。ローカルの Go API は空なので、32バイト以上なら何でも可）"
AUTH_URL="Web の公開 origin（例: http://localhost:3000）"
AUTH_GITHUB_ID="Web 用 GitHub OAuth App の Client ID（Go API の GITHUB_WEB_CLIENT_ID と同じ）"
# FFPF ID でのログイン（任意。2 つそろえると「FFPF IDでログイン」を出します。Client Secret は今は Go API だけが持ちます。段階 11b から Web も使います）。
# FFPF_ID_ISSUER="FFPF ID（portal）の issuer（例: https://ffpf-portal.vercel.app、末尾スラッシュなし。Go API と同じ値）"
# FFPF_ID_CLIENT_ID="portal に登録した zhuelog のクライアント ID（Go API と同じ値）"
# 段階 11b から Web がログインに使う（Go と同じ値）。11a には読む関数があるが、まだどこからも呼ばない。空のままでよい。
GITHUB_WEB_CLIENT_SECRET=""
FFPF_ID_CLIENT_SECRET=""
# 「LINE 連携」画面に出す、LINE 公式アカウントの友だち追加リンク（https:// で始まるものだけ使います。空なら出しません）。
# LINE_ADD_FRIEND_URL="https://line.me/R/ti/p/@your-account"
# 連携コード入りの QR と「LINEで開く」ボタンの送信先（公開ID）。
# LINE_OFFICIAL_ACCOUNT_ID="@393bohaw"
# ローカル専用DBで表示確認する場合は true（本番ボットに送れないQRを非表示）。
# LINE_LINK_PREVIEW_MODE="true"

# --- Web が実行時に DB と JWT の秘密鍵を使う（Go API からの移行の段階 0。docs/api-deployment.md の 6.）---
# Web は、ログイン中の人を決めるために、Go が出す zl_access トークンを自分で確かめ、DB のアカウントを Prisma で読みます。
# DATABASE_URL: Prisma のマイグレーションと seed、Web の実行時の DB 読み取りに使います。本番の実行時は Neon の pooled の URL。
#   ローカルで Go API（pnpm run api:dev）を使うときは、アカウントがその DB にあるので、scripts/api-local-env.sh の API_LOCAL_DATABASE_URL（postgresql://…@127.0.0.1:55440/zhuelog_api）に替えます。
# API_JWT_SECRET: Go と同じ値、32 バイト以上（足りないとトークンはすべて無効）。ローカルは scripts/api-local-env.sh の値。
#   公開の値を例にすると誰でも偽のトークンを作れるので、空のままにしてあります（空なら全員が未ログイン扱い）。
# AUTH_ALLOWED_GITHUB_IDS: 管理者にする GitHub ユーザーの数字の ID（カンマ区切り。Go API と同じ値。空なら管理者は誰も通らない）。
# DEMO_LOGIN_ID: デモアカウントのログイン ID（Go API と同じ値。任意。Web ではデモのリセット /api/cron/demo-reset が使い、空ならそのルートは 404）。
DATABASE_URL="postgresql://zhuelog:zhuelog@localhost:5432/zhuelog?schema=public"
# 単語帳は Web が DB と OpenAI を直接使います（docs/api-deployment.md の 6.）。
# OPENAI_API_KEY: 「AI で下書き」に使う OpenAI の API キー（Go API と同じ値でよい。無ければ下書きは「今は使えません」）。
# OPENAI_LEARNING_MODEL: 下書きと LINE の添削・翻訳のモデル（任意。無ければ gpt-5-mini）。
# OPENAI_CHAT_MODEL: クイック質問と ChatGPT と話すのモデル（任意。無ければ gpt-6.1-sol）。
# OPENAI_API_BASE_URL はテスト専用（ループバックの URL だけ。Production と Preview には設定しない）。
# OPENAI_API_KEY=""
# OPENAI_LEARNING_MODEL="gpt-5-mini"
# OPENAI_CHAT_MODEL="gpt-6.1-sol"
# LINE の webhook と拾い直しは Web が受けます（段階 10a。docs/api-deployment.md の 7. と「段階10…のマージの前と後」）。
# LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN: LINE のチャネルシークレットと長期のアクセストークン（以前 Go に入れていたのと同じチャネルの値）。
#   2 つと OPENAI_API_KEY がそろわないと、LINE 連携は使えません（/api/line/webhook は 404、画面は「LINE 連携は今は使えません。」）。
#   Vercel では Production だけに入れ、Preview には入れません（プレビューが本物の LINE に返事をしないように）。
# CRON_SECRET: /api/cron/line-drain と /api/cron/demo-reset の Authorization: Bearer の秘密（Production だけ。空なら常に 401）。
# LINE_API_BASE_URL はテスト専用（ループバックの URL だけ。Production と Preview には設定しない。e2e は e2e/line-stub.ts に向ける）。
# LINE_CHANNEL_SECRET=""
# LINE_CHANNEL_ACCESS_TOKEN=""
# CRON_SECRET=""
API_JWT_SECRET=""
AUTH_ALLOWED_GITHUB_IDS="0"
DEMO_LOGIN_ID="demo"

# --- services/api（Go API）---
# ローカルで起動する場合のみ。Go API も DATABASE_URL を読みます。本番は Vercel の Go API プロジェクトの環境変数から渡す（docs/api-deployment.md）。
# 手元で試すときは scripts/api-local-env.sh の値を使えます（docs/api-local.md）。
# API_JWT_SECRET と AUTH_ALLOWED_GITHUB_IDS は、Web と同じ値を使うので上に書いています（openssl rand -base64 48 で生成。ID は https://api.github.com/users/<ログイン名> の id）。
# GITHUB_MOBILE_CLIENT_ID="モバイル用 GitHub OAuth App の Client ID"
# GITHUB_MOBILE_CLIENT_SECRET="モバイル用 GitHub OAuth App の Client Secret"
# GITHUB_MOBILE_REDIRECT_URI="アプリのカスタムURLスキーム（例: yourapp://oauth/callback）"
# GITHUB_WEB_CLIENT_ID="Web 用 GitHub OAuth App の Client ID"
# GITHUB_WEB_CLIENT_SECRET="Web 用 GitHub OAuth App の Client Secret"
# GITHUB_WEB_REDIRECT_URI="Web の origin + /api/auth/callback/github/go"
# FFPF ID（4 つそろえる。そろっていなければ起動時のエラー。無ければ POST /v1/auth/ffpf は 503）
# FFPF_ID_ISSUER="FFPF ID（portal）の issuer（Web と同じ値）"
# FFPF_ID_CLIENT_ID="portal に登録した zhuelog のクライアント ID（Web と同じ値）"
# FFPF_ID_CLIENT_SECRET="portal の pnpm run oidc:client で作ったシークレット"
# FFPF_ID_REDIRECT_URI="Web の origin + /api/auth/callback/ffpf"
# API_WEB_PROXY_SECRET="Web と共有する秘密（Web と同じ値）"
# API_TEST_DATABASE_URL="Go のDBテスト専用の接続先（DATABASE_URL とは別。本番を指さない）"
