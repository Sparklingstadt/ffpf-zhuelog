DATABASE_URL="postgresql://zhuelog:zhuelog@localhost:5432/zhuelog?schema=public"
AUTH_SECRET="openssl rand -base64 32 で生成した値"
AUTH_GITHUB_ID="GitHub OAuth AppのClient ID"
AUTH_GITHUB_SECRET="GitHub OAuth AppのClient Secret"
AUTH_ALLOWED_GITHUB_LOGINS="許可するGitHubログイン名（複数はカンマ区切り）"
OPENAI_API_KEY="OpenAI APIキー"
OPENAI_MODEL="gpt-5-mini"

# LINE integration: disabled until deployment, migration and credentials are ready.
LINE_INTEGRATION_ENABLED="false"
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_BOT_USER_ID=""
LINE_ALLOWED_USER_ID=""
# Generate separately: openssl rand -hex 32. Same value on server and Mac.
LINE_WORKER_TOKEN=""
# Mac only. Use the deployed app's HTTPS origin when enabling the relay.
LINE_WORKER_URL="http://localhost:3000"
# Enable only after deploying the development-mode migration/server and updating the Mac worker.
LINE_DEV_MODE_ENABLED="false"
# Mac only: uses the local GitHub CLI login, never transfers GitHub credentials to Vercel.
LINE_DEV_ISSUES_ENABLED="false"
LINE_GH_BIN="/opt/homebrew/bin/gh"
