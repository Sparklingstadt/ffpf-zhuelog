DATABASE_URL="postgresql://zhuelog:zhuelog@localhost:5432/zhuelog?schema=public"
AUTH_SECRET="openssl rand -base64 32 で生成した値"
AUTH_GITHUB_ID="GitHub OAuth AppのClient ID"
AUTH_GITHUB_SECRET="GitHub OAuth AppのClient Secret"
AUTH_ALLOWED_GITHUB_IDS="管理者にするGitHubユーザーの数字のID（複数はカンマ区切り。https://api.github.com/users/<ログイン名> の id）"

# --- Web のログインを Go API で行う場合のみ（docs/api-deployment.md の 6.）---
# GO_API_URL があると、Auth.js ではなく Go API でログインします。消すと Auth.js に戻ります。
# GO_API_URL="http://127.0.0.1:8080"
# API_WEB_PROXY_SECRET="Go API と同じ値（32バイト以上）"
# AUTH_URL="Web の公開 origin（例: http://localhost:3000）"

# --- services/api（ネイティブアプリ向け Go API）---
# ローカルで起動する場合のみ。Go API も DATABASE_URL を読みます。本番は Vercel の Go API プロジェクトの環境変数から渡す（docs/api-deployment.md）。
# API_JWT_SECRET="openssl rand -base64 48 で生成した値（32バイト以上）"
# GITHUB_MOBILE_CLIENT_ID="モバイル用 GitHub OAuth App の Client ID"
# GITHUB_MOBILE_CLIENT_SECRET="モバイル用 GitHub OAuth App の Client Secret"
# GITHUB_MOBILE_REDIRECT_URI="アプリのカスタムURLスキーム（例: yourapp://oauth/callback）"
# API_WEB_PROXY_SECRET="Web と共有する秘密（Web のログインを Go API で行うときだけ。Web と同じ値）"
# API_TEST_DATABASE_URL="Go のDBテスト専用の接続先（DATABASE_URL とは別。本番を指さない）"
