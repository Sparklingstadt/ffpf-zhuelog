# --- Web（Next.js）---
# Web はログインも学習ノートの読み書きも Go API で行います（docs/api-deployment.md の 6.）。
# ローカルでは pnpm run api:dev の Go API（127.0.0.1:8081）を使います。
GO_API_URL="http://127.0.0.1:8081"
API_WEB_PROXY_SECRET="Go API と同じ値（32バイト以上。ローカルの Go API は空なので、32バイト以上なら何でも可）"
AUTH_URL="Web の公開 origin（例: http://localhost:3000）"
AUTH_GITHUB_ID="Web 用 GitHub OAuth App の Client ID（Go API の GITHUB_WEB_CLIENT_ID と同じ）"
# FFPF ID でのログイン（任意。2 つそろえると「FFPF IDでログイン」を出します。Client Secret は Go API だけが持ちます）。
# FFPF_ID_ISSUER="FFPF ID（portal）の issuer（例: https://ffpf-portal.vercel.app、末尾スラッシュなし。Go API と同じ値）"
# FFPF_ID_CLIENT_ID="portal に登録した zhuelog のクライアント ID（Go API と同じ値）"
# 「LINE 連携」画面に出す、LINE 公式アカウントの友だち追加リンク（https:// で始まるものだけ使います。空なら出しません）。
# LINE_ADD_FRIEND_URL="https://line.me/R/ti/p/@your-account"

# --- Prisma（マイグレーションと seed だけ。Web の実行とビルドには要りません）---
DATABASE_URL="postgresql://zhuelog:zhuelog@localhost:5432/zhuelog?schema=public"

# --- services/api（Go API）---
# ローカルで起動する場合のみ。Go API も DATABASE_URL を読みます。本番は Vercel の Go API プロジェクトの環境変数から渡す（docs/api-deployment.md）。
# 手元で試すときは scripts/api-local-env.sh の値を使えます（docs/api-local.md）。
# API_JWT_SECRET="openssl rand -base64 48 で生成した値（32バイト以上）"
# AUTH_ALLOWED_GITHUB_IDS="管理者にするGitHubユーザーの数字のID（複数はカンマ区切り。https://api.github.com/users/<ログイン名> の id）"
# GITHUB_MOBILE_CLIENT_ID="モバイル用 GitHub OAuth App の Client ID"
# GITHUB_MOBILE_CLIENT_SECRET="モバイル用 GitHub OAuth App の Client Secret"
# GITHUB_MOBILE_REDIRECT_URI="アプリのカスタムURLスキーム（例: yourapp://oauth/callback）"
# GITHUB_WEB_CLIENT_ID="Web 用 GitHub OAuth App の Client ID"
# GITHUB_WEB_CLIENT_SECRET="Web 用 GitHub OAuth App の Client Secret"
# GITHUB_WEB_REDIRECT_URI="Web の origin + /api/auth/callback/github/go"
# FFPF ID（4 つそろえる。そろっていなければ起動時のエラー。無ければ POST /v1/auth/ffpf は 503）
# FFPF_ID_ISSUER="FFPF ID（portal）の issuer（Web と同じ値）"
# FFPF_ID_CLIENT_ID="portal に登録した zhuelog のクライアント ID（Web と同じ値）"
# FFPF_ID_CLIENT_SECRET="portal の pnpm run oidc:client で作ったシークレット"
# FFPF_ID_REDIRECT_URI="Web の origin + /api/auth/callback/ffpf"
# API_WEB_PROXY_SECRET="Web と共有する秘密（Web と同じ値）"
# LINE 連携（LINE の 2 つと OPENAI_API_KEY をそろえる。LINE の 2 つが空なら /v1/line/* は 404。docs/api-deployment.md の 7.）
# LINE_CHANNEL_SECRET="LINE Messaging API のチャネルシークレット"
# LINE_CHANNEL_ACCESS_TOKEN="LINE の長期のチャネルアクセストークン"
# OPENAI_API_KEY="OpenAI の API キー（これだけでも管理者の会話練習 /chat が有効になる。docs/api-deployment.md の 8.）"
# OPENAI_CHAT_MODEL="会話練習のモデル（任意。無ければ gpt-6.1-sol）"
# CRON_SECRET="拾い直しの Cron の認証用の秘密（空なら GET /v1/line/drain は常に 401）"
# OPENAI_API_BASE_URL / LINE_API_BASE_URL はテスト専用（ループバックの URL だけ。本番には設定しない）
# API_TEST_DATABASE_URL="Go のDBテスト専用の接続先（DATABASE_URL とは別。本番を指さない）"
