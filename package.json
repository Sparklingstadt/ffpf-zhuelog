{
  "name": "@ffpf-zhuelog/web",
  "version": "0.12.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "test:unit": "node scripts/test-unit.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "pnpm run hooks:install",
    "test:e2e": "docker compose -f compose.e2e.yaml up -d --wait && playwright test",
    "test:e2e:ui": "docker compose -f compose.e2e.yaml up -d --wait && playwright test --ui",
    "test:e2e:stop": "docker compose -f compose.e2e.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "api:db": "bash scripts/api-local.sh db",
    "api:db:stop": "bash scripts/api-local.sh stop",
    "api:dev": "bash scripts/api-local.sh dev",
    "api:smoke": "bash scripts/api-smoke.sh",
    "api-docs:dev": "vuepress dev docs-site",
    "api-docs:build": "vuepress build docs-site",
    "postinstall": "prisma generate",
    "test:regression": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "18.0.8",
    "geist": "^1.8.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "2.0.0-rc.137",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "sass-embedded": "1.105.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vue": "3.5.44",
    "vuepress": "2.0.0-rc.31"
  },
  "packageManager": "pnpm@11.25.0"
}
