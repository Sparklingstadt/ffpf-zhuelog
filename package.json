{
  "name": "@ffpf-zhuelog/web",
  "version": "0.33.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "test:unit": "node scripts/test-unit.mjs",
    "test:migration": "docker compose -f compose.e2e.yaml up -d --wait && node scripts/test-migration.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og:render": "node scripts/render-og-image.mjs",
    "quality:lighthouse": "node scripts/lighthouse.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "pnpm run hooks:install",
    "test:e2e": "docker compose -f compose.e2e.yaml up -d --wait && playwright test",
    "test:e2e:ui": "docker compose -f compose.e2e.yaml up -d --wait && playwright test --ui",
    "test:e2e:stop": "docker compose -f compose.e2e.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:sample": "tsx scripts/sample-members-seed.ts",
    "auth:prepare-admin": "tsx scripts/prepare-better-auth-admin.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:regression": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@next/env": "16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.28",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "dotenv": "18.0.10",
    "geist": "^1.9.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lefthook": "^2.2.2",
    "lighthouse": "13.6.0",
    "pinyin-pro": "^3.29.5",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "packageManager": "pnpm@11.25.0"
}
